FYP_ENVIRONMENT=local
FYP_STORAGE_BACKEND=s3
FYP_LOCAL_STORAGE_ROOT=./data
DATABASE_URL=postgresql+psycopg://fyp_user:change_me@localhost:5432/fyp_data
DB_NAME=fyp_data
DB_USER=fyp_user
DB_PASSWORD=change_me
DB_PORT=5432

# Local MinIO. Keep AWS_ACCESS_KEY_ID/SECRET_ACCESS_KEY matched to these values.
MINIO_ROOT_USER=fyp_minio
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# S3-compatible application configuration. These local credentials are not AWS keys.
AWS_ACCESS_KEY_ID=fyp_minio
AWS_SECRET_ACCESS_KEY=change_me_minio
# For real AWS only: uncomment and set AWS_PROFILE when using local SSO.
# AWS_PROFILE=fyp-dev
AWS_REGION=ap-southeast-1
S3_BUCKET=fyp-local
S3_PREFIX=fyp-dev
S3_ENDPOINT_URL=http://localhost:9000
# Leave blank for local MinIO. AWS configuration defaults to AES256.
S3_SERVER_SIDE_ENCRYPTION=
S3_KMS_KEY_ID=

# Authoritative multimodal inference project.
FYP_MODEL_PROJECT_PATH=../FYPModels
FYP_MODEL_PYTHON=

# Legacy only; retained for historical SeizeIT2 annotation ingestion.
BODY_POSE_PROJECT_PATH=../BodyPose/body_pose_fyp
BODY_POSE_PYTHON=
FYP_WORK_ROOT=./work
LOG_LEVEL=INFO
